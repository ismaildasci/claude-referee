{
  "description": "claude-referee: a short local briefing at session start, and an opt-in Stop check that only records its decision. Both act only in projects with .claude/referee.json.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs",
              "session-start"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs",
              "stop"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
