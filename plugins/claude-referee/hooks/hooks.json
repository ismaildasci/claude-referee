{
  "description": "claude-referee: a short local briefing at session start, only in projects with .claude/referee.json.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs", "session-start"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
